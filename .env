
# This env file defines the necessary environmental variables for initializing
# the MongoDB database and Spring Boot App, including ports, credentials for
# admin user, and db user that spring boot uses for db operations.
# The variable values below work as is and can be left as is if the user
# intends to use the application locally. If not, the user is encouraged
# to configure longer and more complicated passwords.

SPRING_BOOT_PORT=8080
MONGO_DB_PORT=27017

MONGO_INITDB_ROOT_USERNAME="admin" # change as needed
MONGO_INITDB_ROOT_PASSWORD="cat123" # change (recommended)

SPLIT_EXPENSE_DB="split_expenses" # change as needed
SPLIT_EXPENSE_DB_USER="split_cost_user" # Change as needed
SPLIT_EXPENSE_DB_PASSWORD="cat1234" # change (recommended)